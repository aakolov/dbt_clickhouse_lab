{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract": {
      "type": "object",
      "properties": {
        "version": {"type": "string"},
        "source": {"type": "string"},
        "description": {"type": "string"},
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "type": {"type": "string"},
              "nullable": {"type": "boolean"},
              "description": {"type": "string"}
            },
            "required": ["name", "type", "nullable", "description"]
          }
        },
        "validations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {"type": "string"},
              "fields": {"type": "array", "items": {"type": "string"}},
              "field": {"type": "string"},
              "reference": {"type": "string"}
            },
            "required": ["type"]
          }
        }
      },
      "required": ["version", "source", "fields"]
    }
  },
  "required": ["contract"]
}
